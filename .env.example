# ==============================================================================
# Nuvorix Platform Environment Configuration Template
# Copy this file to .env and adjust variables for your target deployment mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Environment Mode
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # "development" | "staging" | "production"
PROJECT_NAME="Nuvorix Control Plane"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Authentication & RBAC Security
# In 'production', AUTH_MODE must be 'production', AUTH_ENABLED must be true,
# and SECRET_KEY must be a cryptographically random string >= 32 characters.
# ------------------------------------------------------------------------------
AUTH_MODE=development                  # "development" allows dev headers; "production" enforces tokens/keys
AUTH_ENABLED=true
DEFAULT_ORG_ID=org-demo-nuvorix
DEFAULT_USER_ID=dev-demo-user
DEFAULT_USER_ROLE=admin                # admin | platform_engineer | ml_engineer | developer | viewer
SECRET_KEY=nuvorix-insecure-dev-secret-key-change-in-production
API_KEY_PREFIX=nvx_

# ------------------------------------------------------------------------------
# Database & Cache Persistence
# In 'production', PostgreSQL is required (SQLite is rejected at startup).
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./nuvorix.db
# DATABASE_URL=postgresql+asyncpg://nuvorix:nuvorix_password@localhost:5432/nuvorix
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# MLflow Tracking & Artifact Storage
# In 'production', an external MLflow server tracking URI is required.
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_TRACKING_URI=http://mlflow.internal:5000
MLFLOW_BACKEND_STORE_URI=
MLFLOW_ARTIFACT_ROOT=
ARTIFACT_STORE_PATH=./artifacts

# ------------------------------------------------------------------------------
# S3 / Object Storage (Optional for S3-compatible backends)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# Remote LLM Providers (OpenAI, Anthropic, Gemini, Groq, Ollama)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LOCAL_LLM_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# Observability, Metrics & Distributed Tracing
# ------------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
OTEL_ENABLED=true
OTEL_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------------------------
# CORS Configuration (JSON array format)
# In 'production', localhost origins are rejected.
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# Frontend Web Console (Vite Public Variables)
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
VITE_PLATFORM_NAME="Nuvorix"
